{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "MealBot"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "MealBot",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "Run sample shortcut",
        "type": "global",
        "callback_id": "sample_shortcut_id",
        "description": "Runs a sample shortcut"
      }
    ],
    "slash_commands": [
      {
        "command": "/sample-command",
        "description": "Runs a sample command",
        "should_escape": false
      },
      {
        "command": "/meal-settings",
        "description": "Set the meal search location and radius",
        "should_escape": false
      },
      {
        "command": "/meal-fetch",
        "description": "Fetch restaurants from Hot Pepper and/or Google Places",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "channels:history", "chat:write", "commands", "im:history"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_home_opened", "app_mention", "message.channels", "message.im"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
